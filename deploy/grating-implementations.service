[Unit]
Description=Grating Lab implementation and validation library
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPOSITORY@
# The library calls no model since roadmap H8: no provider setting.
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=@REPOSITORY@/.venv/bin/python -m dqn_meent.implementations.api --port 8766
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
