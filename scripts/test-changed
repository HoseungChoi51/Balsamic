#!/usr/bin/env python3
"""Run the tests that touch what this branch changed: the changed test files, and every test file that imports a changed
module under src/. A quick check while working; it misses tests that reach a module only through another one, so run the
full suite (with -n 4) before a PR.

    scripts/test-changed                 # against origin/main, plus uncommitted changes
    scripts/test-changed --base main     # against another base
    scripts/test-changed --list          # print the test files, run nothing
    scripts/test-changed -- -x -k name   # anything after -- goes to pytest
"""
import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def changed(base):
    names = set()
    for command in (["git", "diff", "--name-only", f"{base}...HEAD"], ["git", "diff", "--name-only", "HEAD"],
                    ["git", "ls-files", "--others", "--exclude-standard"]):
        names.update(subprocess.run(command, cwd=ROOT, capture_output=True, text=True, check=True).stdout.split())
    return sorted(name for name in names if name.endswith(".py") and (ROOT / name).exists())


def importers(module, tests):
    """The test files that import module, as `module`, `module.x`, or `from parent import ... name`."""
    parent, _, name = module.rpartition(".")
    direct = re.compile(rf"\b{re.escape(module)}\b")
    named = re.compile(rf"^\s*from\s+{re.escape(parent)}\s+import\s+[^\n]*\b{re.escape(name)}\b|"
                       rf"^\s*from\s+{re.escape(parent)}\s+import\s*\([^)]*\b{re.escape(name)}\b", re.M) if parent else None
    return {test for test, text in tests.items() if direct.search(text) or (named and named.search(text))}


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--list", action="store_true")
    parser.add_argument("pytest_args", nargs="*")
    args = parser.parse_args()
    tests = {str(path.relative_to(ROOT)): path.read_text(errors="replace")
             for path in sorted((ROOT / "tests").rglob("test_*.py"))}
    selected = set()
    for name in changed(args.base):
        if name in tests:
            selected.add(name)
        elif name.startswith("src/"):
            module = name[len("src/"):-len(".py")].replace("/", ".").removesuffix(".__init__")
            selected |= importers(module, tests)
    selected = sorted(selected)
    if not selected:
        print("No test file imports what changed; run the full suite.", file=sys.stderr)
        return 1
    print("\n".join(selected))
    if args.list:
        return 0
    launcher = "tests/test_server_launcher.py"
    env = {**os.environ, "GRATING_LLM_DISABLED": "true"}
    rest = [test for test in selected if test != launcher]
    code = 0
    if rest:
        workers = ["-n", "4", "--dist", "worksteal"] if len(rest) > 1 else []
        code = subprocess.run(["uv", "run", "--extra", "dev", "pytest", "-q", *workers, *rest, *args.pytest_args],
                              cwd=ROOT, env=env).returncode
    if launcher in selected:
        # The launcher refuses root; in the cloud container it runs as the normal user, claude.
        command = [".venv/bin/python", "-m", "pytest", "-q", "-p", "no:cacheprovider", launcher, *args.pytest_args]
        if os.geteuid() == 0:
            command = ["runuser", "-u", "claude", "--", "env", "HOME=/home/claude", "GRATING_LLM_DISABLED=true", *command]
        code = subprocess.run(command, cwd=ROOT, env=env).returncode or code
    return code


if __name__ == "__main__":
    sys.exit(main())
