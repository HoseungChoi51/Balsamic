      "value": 80.0,
      "units": "C",
      "range": [
        20.0,
        200.0
      ],
      "citation": 1
    },
    "max_temperature_c": {
      "description": "Decomposition temperature of the product",
      "value": 150.0,
      "units": "C",
      "citation": 1
    },
    "solvent_viscosity_cp": {
      "description": "Solvent viscosity at the temperature",
      "role": "derived",
      "units": "cP",
      "expression": "table(viscosity, temperature_c)"
    },
    "repeats": {
      "description": "Repeat measurements per condition",
