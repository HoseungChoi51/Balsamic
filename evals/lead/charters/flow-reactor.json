{
  "title": "Flow reactor yield",
  "summary": "Maximize the yield of a flow reaction at {pressure_bar}.",
  "text": "A tubular reactor of {reactor_volume_ml} runs at {pressure_bar} and {temperature_c}. The residence time follows from the flow rate: {residence_time_s:.3g}.",
  "quantities": {
    "reactor_volume_ml": {
      "description": "Reactor volume",
      "value": 10.0,
      "units": "mL",
      "range": [
        0,
        null
      ],
      "citation": 1
    },
    "flow_rate_ml_min": {
      "description": "Flow rate",
      "value": 2.0,
      "units": "mL/min",
      "range": [
        0.1,
        20.0
      ],
      "citation": 1
    },
    "residence_time_s": {
      "description": "Residence time",
      "role": "derived",
      "units": "s",
      "expression": "reactor_volume_ml / flow_rate_ml_min * 60"
    },
    "pressure_bar": {
      "description": "Back pressure",
      "value": 5.0,
      "units": "bar",
      "citation": 1
    },
