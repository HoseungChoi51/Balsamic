{
  "id": "S19-charter-to-results",
  "source": "Roadmap G2: Phase 1's flow live, from a confirmed charter to ranked results. Asked once and approved once, the lead files one compute request; Balsamic builds nothing itself but installs the coding workspace's library, adopts its problem, binds the proposals and starts the runs; the lead ranks them by tardiness from the comparison report",
  "setup": {"preset": "baking_order", "llm_budget_usd": 1.5, "development": true},
  "steps": [
    {"say": "Implement earliest due date, swap search and exact enumeration, and compare them."},
    {"wait": "idle", "timeout_s": 900},
    {"approve_latest_decision": "Go ahead"},
    {"wait": "seconds", "seconds": 60},
    {"wait": "compared", "timeout_s": 5400, "live_only": true},
    {"wait": "idle", "timeout_s": 600}
  ],
  "checks": [
    {"commands_with": {"operation": "approval.request", "payload": {"kind": "compute"}, "count": 1}},
    {"commands_with": {"operation": "approval.request", "payload": {"kind": "compute"}, "matches": "^(?=.*\"coding_workspaces\": [1-9])(?=.*\"runs\": \\[\\{)", "count": 1}},
    {"commands_exactly": {"operation": "implementation.bind_builtin", "count": 0}},
    {"no_commands": ["trial.create", "draft.launch"]},
    {"researcher_actions": 2},
    {"live_only": {"trials_started_by": {"actor": "balsamic", "count": 3}}},
    {"live_only": {"commands_at_least": {"operation": "comparison.report", "count": 1}}},
    {"live_only": {"reply_ranks_by_report": true}},
    {"reply_contains_none": ["pip install", "uv add", "uv sync", "in a terminal"]}
  ],
  "repeats": 1
}
