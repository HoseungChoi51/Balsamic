"""The library is the problem the charter describes, and each method meets Balsamic's contract. Generated by Balsamic.

These tests run where Balsamic is installed and are skipped elsewhere, so the project still runs on its own.
"""
from __future__ import annotations

import json
from pathlib import Path

import pytest

pytest.importorskip("optimization_framework")

from optimization_framework.evaluation.registry import ProblemRegistry, problems   # noqa: E402
from optimization_framework.optimizers.conformance import check_function   # noqa: E402
from optimization_framework.problem_charter.charter import compare_provided, manifest, parse, resolve   # noqa: E402

from __PKG__ import adapter, data   # noqa: E402
from __PKG__.harness import methods   # noqa: E402

CHARTER = parse(json.loads((Path(__file__).resolve().parents[1] / "charter.json").read_text(encoding="utf-8"))["charter"])
# The charter's problem at its own values, as Balsamic declares it.
DECLARED = manifest(CHARTER, resolve(CHARTER)["values"])
# A declared evaluator is this library's to provide; an installed one is another package's, and only the methods are here.
PROVIDED = CHARTER.evaluator.kind == "declared"
REGISTRY = ProblemRegistry().extended(adapter.problem_adapter()) if PROVIDED else problems
METHODS = methods()


def test_the_library_holds_the_charter_revision():
    assert parse(data.CHARTER) == CHARTER and data.PROBLEM_ID == CHARTER.evaluator.problem_id


@pytest.mark.skipif(not PROVIDED, reason="The charter's evaluator is an installed problem, not this library's")
def test_the_library_is_the_problem_the_charter_declares():
    assert adapter.problem_adapter().describe().id == DECLARED.id
    assert compare_provided(DECLARED, REGISTRY.resolve(DECLARED.id, DECLARED.configuration, DECLARED.fidelity)) == []


@pytest.mark.parametrize("method", sorted(METHODS))
def test_each_method_meets_the_contract(method):
    instance = REGISTRY.resolve(DECLARED.id, DECLARED.configuration, DECLARED.fidelity)
    check_function(adapter.method_plugin(), method, instance, registry=REGISTRY)
