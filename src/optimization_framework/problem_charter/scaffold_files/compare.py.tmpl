"""Run every method on every instance and rank the runs by the objective's direction. Generated by Balsamic.

    python -m __PKG__.compare [--seeds N] [--seconds S] [--evaluations M] [--instance NAME] [--method NAME]

The default cap is time (--seconds), because a method may compute the objective without calling `evaluate`. A method
marked `@deterministic` runs once whatever --seeds says; every other method runs once per seed.
"""
from __future__ import annotations

import argparse
import sys

from .harness import run
from .methods import METHODS
from .problem import PROBLEMS

DEFAULT_SECONDS = 10.0
DEFAULT_SEEDS = 2


def compare(methods=None, problems=None, *, seeds: int = DEFAULT_SEEDS, seconds: float | None = None,
            evaluations: int | None = None) -> list[dict]:
    """One row per run: instance, method, seed, best value, evaluations, seconds, how it stopped, and any error."""
    methods = METHODS if methods is None else methods
    problems = list(PROBLEMS.values()) if problems is None else problems
    if seconds is None and evaluations is None:
        seconds = DEFAULT_SECONDS
    rows = []
    for problem in problems:
        for name, method in methods.items():
            for seed in range(1 if getattr(method, "deterministic", False) else seeds):
                row = {"instance": problem.instance, "method": name, "seed": seed,
                       "deterministic": bool(getattr(method, "deterministic", False))}
                try:
                    result = run(method, problem, seed, seconds, evaluations, name=name)
                except Exception as exc:   # one failing method does not end the comparison
                    row.update(best=None, evaluations=None, seconds=None, stopped="failed", error=f"{type(exc).__name__}: {exc}")
                else:
                    row.update(best=result.best_value, evaluations=result.evaluations, seconds=result.elapsed,
                               stopped=result.stopped, error=None)
                rows.append(row)
    return rows


def ranked(rows: list[dict], problem) -> list[dict]:
    """The runs of one instance, best first in the objective's direction; runs with no value last."""
    mine = [row for row in rows if row["instance"] == problem.instance]
    scored = sorted((row for row in mine if row["best"] is not None),
                    key=lambda row: row["best"] if problem.minimize else -row["best"])
    return scored + [row for row in mine if row["best"] is None]


def table(rows: list[dict], problem) -> str:
    header = (f"{problem.instance} ({problem.split}): {problem.direction} {problem.objective}"
              + (f" ({problem.units})" if problem.units not in ("", "1") else ""))
    lines = [header, f"{'rank':>4}  {'method':<24} {'seed':>4}  {'best':>14}  {'evaluations':>11}  {'seconds':>8}  stopped"]
    for rank, row in enumerate(ranked(rows, problem), 1):
        best = "—" if row["best"] is None else f"{row['best']:.6g}"
        seed = "—" if row["deterministic"] else str(row["seed"])
        evaluations = "—" if row["evaluations"] is None else str(row["evaluations"])
        seconds = "—" if row["seconds"] is None else f"{row['seconds']:.2f}"
        stopped = row["stopped"] + (f": {row['error']}" if row["error"] else "")
        lines.append(f"{rank:>4}  {row['method']:<24} {seed:>4}  {best:>14}  {evaluations:>11}  {seconds:>8}  {stopped}")
    return "\n".join(lines)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="python -m __PKG__.compare", description=__doc__.splitlines()[0])
    parser.add_argument("--seeds", type=int, default=DEFAULT_SEEDS, help="runs per method that is not deterministic")
    parser.add_argument("--seconds", type=float, help=f"time per run (default {DEFAULT_SECONDS:g} when no cap is given)")
    parser.add_argument("--evaluations", type=int, help="evaluations per run")
    parser.add_argument("--instance", action="append", help="only this instance (repeatable)")
    parser.add_argument("--method", action="append", help="only this method (repeatable)")
    args = parser.parse_args(argv)
    methods = {name: METHODS[name] for name in (args.method or METHODS)}
    if not methods:
        print("No methods: add them to METHODS in methods.py.", file=sys.stderr)
        return 1
    problems = [PROBLEMS[name] for name in (args.instance or PROBLEMS)]
    rows = compare(methods, problems, seeds=args.seeds, seconds=args.seconds, evaluations=args.evaluations)
    print("\n\n".join(table(rows, problem) for problem in problems))
    return 0


if __name__ == "__main__":
    sys.exit(main())
