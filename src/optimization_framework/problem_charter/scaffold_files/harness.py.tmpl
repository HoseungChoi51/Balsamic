"""Run a method on a problem under a cap and record what it found. Generated by Balsamic.

    result = run(method, problem, seed=0, max_seconds=10)

A method is `method(problem, evaluate, rng)`. `evaluate(candidate)` returns the objective and raises `StopSearch` once
the run's seconds or evaluations are spent. `rng` is a `numpy.random.Generator` seeded for the run. A method that
computes the objective itself is stopped at `max_seconds` all the same. If it returns a candidate, that candidate is
evaluated once more while the evaluation cap allows.
"""
from __future__ import annotations

import math
import signal
import threading
import time
from contextlib import contextmanager
from dataclasses import dataclass, field

import numpy as np

from . import objective as _objective
from .problem import Problem


class StopSearch(BaseException):
    """The run's cap is reached. A BaseException, so that `except Exception` in a method does not swallow it."""


class InvalidCandidate(ValueError):
    """A candidate the charter does not allow: the message says what it breaks."""


def deterministic(method):
    """Mark a method whose runs do not depend on the seed: the comparison runs it once."""
    method.deterministic = True
    return method


@dataclass
class Result:
    method: str
    instance: str
    seed: int
    best: list[float] | None              # the best candidate evaluated
    best_value: float | None
    evaluations: int
    elapsed: float                        # seconds
    stopped: str                          # finished, seconds or evaluations
    log: list[dict] = field(default_factory=list)   # one row per evaluation: evaluation, seconds, value, best


class Evaluate:
    """The `evaluate` a method is given: counts, times and keeps the best."""

    def __init__(self, problem: Problem, max_seconds: float | None, max_evaluations: int | None):
        self.problem, self.max_evaluations = problem, max_evaluations
        self.start = time.perf_counter()
        self.deadline = None if max_seconds is None else self.start + max_seconds
        self.evaluations, self.best, self.best_value, self.log = 0, None, None, []

    @property
    def elapsed(self) -> float:
        return time.perf_counter() - self.start

    def check(self):
        """Raise `StopSearch` if the run's cap is reached; a method may call it between steps of its own."""
        if self.max_evaluations is not None and self.evaluations >= self.max_evaluations:
            raise StopSearch("evaluations")
        if self.deadline is not None and time.perf_counter() >= self.deadline:
            raise StopSearch("seconds")

    def __call__(self, candidate) -> float:
        self.check()
        return self._evaluate(candidate)

    def _evaluate(self, candidate) -> float:
        broken = self.problem.violations(candidate)
        hard = [line for line in broken if not line.startswith("soft constraint ")]
        if hard:
            raise InvalidCandidate("; ".join(hard))
        flat = np.asarray(candidate, dtype=float).copy()
        value = float(_objective.objective(self.problem, flat.copy()))
        if not math.isfinite(value):
            raise ValueError(f"The objective gave {value} for a valid candidate")
        self.evaluations += 1
        if self.problem.better(value, self.best_value):
            self.best, self.best_value = flat.tolist(), value
        self.log.append({"evaluation": self.evaluations, "seconds": round(self.elapsed, 6), "value": value,
                         "best": self.best_value})
        return value


@contextmanager
def _alarm(seconds: float | None, armed: dict):
    """Raise StopSearch in the main thread after `seconds`, even inside a method's own loop."""
    if seconds is None or threading.current_thread() is not threading.main_thread() or not hasattr(signal, "setitimer"):
        yield
        return

    def stop(signum, frame):
        if armed["on"]:
            raise StopSearch("seconds")
    previous = signal.signal(signal.SIGALRM, stop)
    signal.setitimer(signal.ITIMER_REAL, max(seconds, 1e-3))
    try:
        yield
    finally:
        armed["on"] = False
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def run(method, problem: Problem, seed: int, max_seconds: float | None = None, max_evaluations: int | None = None,
        *, name: str | None = None) -> Result:
    """Run `method` once on `problem` with `seed`, until it returns or reaches a cap. At least one cap is required."""
    if max_seconds is None and max_evaluations is None:
        raise ValueError("Give max_seconds, max_evaluations or both")
    rng = np.random.default_rng(seed)
    evaluate = Evaluate(problem, max_seconds, max_evaluations)
    armed, stopped, returned = {"on": True}, "finished", None
    try:
        with _alarm(max_seconds, armed):
            try:
                returned = method(problem, evaluate, rng)
            finally:
                armed["on"] = False
    except StopSearch as stop:
        stopped = stop.args[0] if stop.args else "seconds"
    elapsed = evaluate.elapsed
    if stopped == "finished" and returned is not None and (max_evaluations is None or evaluate.evaluations < max_evaluations):
        if evaluate.best is None or list(np.asarray(returned, dtype=float).reshape(-1)) != evaluate.best:
            evaluate._evaluate(returned)
    return Result(method=name or getattr(method, "__name__", "method"), instance=problem.instance, seed=seed,
                  best=evaluate.best, best_value=evaluate.best_value, evaluations=evaluate.evaluations,
                  elapsed=elapsed, stopped=stopped, log=evaluate.log)
