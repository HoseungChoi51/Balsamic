"""The data agrees with charter.json, and the objective with the charter. Generated by Balsamic."""
from __future__ import annotations

import hashlib
import json
import math
from pathlib import Path

import numpy as np
import pytest

from __PKG__ import data
from __PKG__.objective import objective
from __PKG__.problem import PROBLEMS

CHARTER_FILE = json.loads((Path(__file__).resolve().parents[1] / "charter.json").read_text(encoding="utf-8"))
CHARTER = CHARTER_FILE["charter"]
# A reported result is usually rounded: how close the objective must come to it.
REFERENCE_TOLERANCE = 1e-3


def valid_candidate(problem):
    """A candidate the charter allows, found by sampling within the bounds; None if sampling finds none."""
    rng = np.random.default_rng(0)
    for _ in range(2000):
        candidate = problem.random_candidate(rng)
        if problem.is_valid(candidate):
            return candidate
    return None


def test_the_data_is_the_charter_revision():
    text = json.dumps(CHARTER, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
    assert hashlib.sha256(text).hexdigest() == CHARTER_FILE["content_hash"] == data.CONTENT_HASH
    assert (data.CHARTER_ID, data.REVISION) == (CHARTER_FILE["charter_id"], CHARTER_FILE["revision"])
    assert data.OBJECTIVE == {key: CHARTER["objective"][key] for key in ("name", "direction", "units")}


@pytest.mark.parametrize("name", list(data.INSTANCES))
def test_each_instance_holds_the_charter_inputs(name):
    instance = next((row for row in CHARTER["instances"] if row["name"] == name), {"values": {}})
    for quantity, row in CHARTER["quantities"].items():
        if row["role"] == "input":
            assert data.INSTANCES[name]["values"][quantity] == instance["values"].get(quantity, row["value"]), quantity


@pytest.mark.parametrize("name", list(data.INSTANCES))
def test_dimensions_follow_the_variables(name):
    problem = PROBLEMS[name]
    assert [v.name for v in problem.variables] == [v["name"] for v in CHARTER["variables"]]
    assert problem.dimensions == sum(v.size for v in problem.variables) == sum(int(np.prod(v.shape)) for v in problem.variables)
    assert [v.offset for v in problem.variables] == [sum(w.size for w in problem.variables[:i]) for i in range(len(problem.variables))]
    assert all(c.coefficients.shape == (problem.dimensions,) for c in problem.constraints)


@pytest.mark.parametrize("name", list(data.INSTANCES))
def test_is_valid_accepts_a_valid_candidate_and_refuses_others(name):
    problem = PROBLEMS[name]
    assert not problem.is_valid(np.zeros(problem.dimensions + 1))
    assert not problem.is_valid(np.full(problem.dimensions, np.nan))
    candidate = valid_candidate(problem)
    if candidate is None:
        pytest.skip("Sampling found no candidate that meets the linear constraints; write one here")
    assert problem.is_valid(candidate) and problem.is_valid(list(candidate))


@pytest.mark.parametrize("name", list(data.INSTANCES))
def test_the_objective_is_finite_and_repeats(name):
    problem = PROBLEMS[name]
    candidate = valid_candidate(problem)
    if candidate is None:
        pytest.skip("Sampling found no valid candidate to evaluate")
    first = objective(problem, candidate.copy())
    assert isinstance(first, (int, float, np.integer, np.floating)) and math.isfinite(first)
    if data.DETERMINISTIC:
        assert objective(problem, candidate.copy()) == first


def applies(reference, problem):
    for name, value in reference["holds_at"].items():
        if name in data.INSTANCES[problem.instance]["values"]:
            current = problem.values[name]
            same = math.isclose(value, current, rel_tol=1e-9, abs_tol=1e-12) if isinstance(value, (int, float)) \
                and isinstance(current, (int, float)) else value == current
            if not same:
                return False
    return True


@pytest.mark.parametrize("reference", data.REFERENCES, ids=[f"reference_{i + 1}" for i in range(len(data.REFERENCES))])
def test_reference_results(reference):
    stated = f"{reference['value']} {reference['units']}".strip() + f" ({reference['statement']})"
    variables = [v["name"] for v in CHARTER["variables"]]
    if reference["value"] is None:
        pytest.skip(f"The reference states no number: {reference['statement']}")
    if not all(name in reference["holds_at"] for name in variables):
        pytest.skip(f"The charter's reference {stated} names no candidate to check it against")
    problem = next((p for p in PROBLEMS.values() if applies(reference, p)), None)
    if problem is None:
        pytest.skip(f"No instance has the values the reference {stated} holds at")
    candidate = problem.pack({name: reference["holds_at"][name] for name in variables})
    assert float(objective(problem, candidate)) == pytest.approx(reference["value"], rel=REFERENCE_TOLERANCE)
