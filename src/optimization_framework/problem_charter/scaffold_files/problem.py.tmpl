"""Each instance of the charter as a typed `Problem`, and the check of a candidate. Generated by Balsamic.

A candidate is a flat sequence of `problem.dimensions` numbers: the decision variables one after another, in the
charter's order, each laid out as its `layout` says. `problem.unpack(candidate)` gives each variable in its shape. An
order (a permutation variable) is the items 0 to size - 1, each once, as numbers: `.astype(int)` gives indices.
A structured candidate is one JSON value instead (lists, objects, numbers): `structure.py` says what a valid one is,
and `problem.canonicalize(candidate)` gives its one form.
"""
from __future__ import annotations

import bisect
from dataclasses import dataclass

import numpy as np

from . import data

TOLERANCE = 1e-9


__VALUES__


@dataclass(frozen=True)
class Variable:
    name: str
    representation: str          # binary, discrete, continuous, permutation or structured
    shape: tuple[int, ...]
    size: int
    offset: int                  # where its elements start in a candidate
    lower: float | None          # continuous variables; None is open
    upper: float | None
    values: tuple[float, ...]    # the permitted values of a discrete variable
    units: str
    meaning: str
    layout: str
    fields: tuple[str, ...] = ()  # a structured variable: the names structure.fields() gives


@dataclass(frozen=True)
class LinearConstraint:
    id: str
    statement: str
    kind: str                    # hard (is_valid enforces it) or soft (reported by violations only)
    relation: str                # le, ge or eq
    bound: float
    coefficients: np.ndarray     # one per candidate element

    def holds(self, candidate) -> bool:
        total = float(self.coefficients @ np.asarray(candidate, dtype=float))
        slack = TOLERANCE * max(1.0, abs(self.bound))
        if self.relation == "le":
            return total <= self.bound + slack
        if self.relation == "ge":
            return total >= self.bound - slack
        return abs(total - self.bound) <= slack


@dataclass(frozen=True)
class Problem:
    instance: str
    split: str
    values: Values
    variables: tuple[Variable, ...]
    constraints: tuple[LinearConstraint, ...]
    representation: str
    dimensions: int
    objective: str
    direction: str               # minimize or maximize
    units: str

    @property
    def structured(self) -> bool:
        """The candidate is one value whose rules structure.py owns."""
        return self.representation == "structured"

    def canonicalize(self, candidate):
        """The one form of a candidate: structure.canonicalize for a structured one, else a flat array of numbers."""
        if self.structured:
            from . import structure
            return structure.canonicalize(self, candidate)
        return np.asarray(candidate, dtype=float)

    @property
    def minimize(self) -> bool:
        return self.direction == "minimize"

    def better(self, value: float, than: float | None) -> bool:
        """Whether `value` is better than `than` in the objective's direction."""
        return than is None or (value < than if self.minimize else value > than)

    def table(self, name: str, x: float) -> float:
        """The charter's table `name` read at `x`, interpolated linearly; never extrapolated."""
        points = data.TABLES[name]
        xs = [point[0] for point in points]
        if x < xs[0] or x > xs[-1]:
            raise ValueError(f"{x:g} is outside table {name} ({xs[0]:g} to {xs[-1]:g})")
        index = bisect.bisect_left(xs, x)
        if xs[index] == x:
            return float(points[index][1])
        (x0, y0), (x1, y1) = points[index - 1], points[index]
        return float((y1 - y0) / (x1 - x0) * (x - x0) + y0)

    def unpack(self, candidate) -> dict[str, np.ndarray]:
        """Each decision variable's elements, in its shape; a structured candidate as it is."""
        if self.structured:
            return {self.variables[0].name: candidate}
        flat = np.asarray(candidate, dtype=float)
        return {v.name: flat[v.offset:v.offset + v.size].reshape(v.shape) for v in self.variables}

    def pack(self, parts: dict) -> np.ndarray:
        """A candidate from each variable's elements (any shape with the right size)."""
        if self.structured:
            return parts[self.variables[0].name]
        return np.concatenate([np.asarray(parts[v.name], dtype=float).reshape(-1) for v in self.variables])

    def random_candidate(self, rng: np.random.Generator) -> np.ndarray:
        """A candidate drawn within each variable's bounds or values. It may still break a linear constraint. A structured
        candidate is drawn by structure.random_candidate."""
        if self.structured:
            from . import structure
            return structure.random_candidate(self, rng)
        parts = []
        for v in self.variables:
            if v.representation == "binary":
                parts.append(rng.integers(0, 2, v.size).astype(float))
            elif v.representation == "discrete":
                parts.append(rng.choice(np.asarray(v.values, dtype=float), v.size))
            elif v.representation == "permutation":
                parts.append(rng.permutation(v.size).astype(float))
            else:
                low = v.lower if v.lower is not None else (v.upper - 1.0 if v.upper is not None else -1.0)
                high = v.upper if v.upper is not None else low + 2.0
                parts.append(rng.uniform(low, high, v.size))
        return np.concatenate(parts) if parts else np.zeros(0)

    def violations(self, candidate) -> list[str]:
        """Why a candidate is not allowed, soft constraints included; empty when it breaks nothing."""
        if self.structured:
            from . import structure
            try:
                value = structure.canonicalize(self, candidate)
            except (TypeError, ValueError, KeyError, IndexError) as exc:
                return [f"the candidate cannot be read: {exc}"]
            return [str(line) for line in structure.is_valid(self, value)]
        try:
            flat = np.asarray(candidate, dtype=float)
        except (TypeError, ValueError):
            return ["the candidate is not a sequence of numbers"]
        if flat.ndim != 1 or flat.size != self.dimensions:
            return [f"the candidate has shape {flat.shape}, not ({self.dimensions},)"]
        if not np.all(np.isfinite(flat)):
            return ["the candidate has a value that is not finite"]
        out = []
        for v in self.variables:
            part = flat[v.offset:v.offset + v.size]
            if v.representation == "binary":
                bad = ~np.isin(part, (0.0, 1.0))
                rule = "0 or 1"
            elif v.representation == "discrete":
                allowed = np.asarray(v.values, dtype=float)
                bad = ~np.any(np.isclose(part[:, None], allowed[None, :], rtol=TOLERANCE, atol=TOLERANCE), axis=1)
                rule = f"one of {list(v.values)}"
            elif v.representation == "permutation":
                if sorted(part.tolist()) != list(range(v.size)):
                    out.append(f"{v.name}: not an order of the items 0 to {v.size - 1}, each once")
                continue
            else:
                bad = np.zeros(v.size, dtype=bool)
                if v.lower is not None:
                    bad |= part < v.lower - TOLERANCE * max(1.0, abs(v.lower))
                if v.upper is not None:
                    bad |= part > v.upper + TOLERANCE * max(1.0, abs(v.upper))
                rule = f"between {v.lower} and {v.upper}"
            if bad.any():
                out.append(f"{v.name}: {int(bad.sum())} element(s) not {rule}")
        for constraint in self.constraints:
            if not constraint.holds(flat):
                out.append(f"{constraint.kind} constraint {constraint.id} broken: {constraint.statement}")
        return out

    def is_valid(self, candidate) -> bool:
        """Whether a candidate meets the schema and every hard linear constraint."""
        return not [line for line in self.violations(candidate) if not line.startswith("soft constraint ")]


def _problem(name: str, instance: dict) -> Problem:
    candidate = instance["candidate"]
    variables = tuple(Variable(name=v["name"], representation=v["representation"], shape=tuple(v["shape"]), size=v["size"],
                               offset=v["offset"], lower=v["lower"], upper=v["upper"], values=tuple(v["values"]),
                               units=v["units"], meaning=v["meaning"], layout=v["layout"], fields=tuple(v.get("fields", ())))
                      for v in candidate["variables"])
    by_name = {v.name: v for v in variables}
    constraints = []
    for c in candidate["constraints"]:
        line = np.zeros(candidate["dimensions"])
        for term in c["terms"]:
            v = by_name[term["variable"]]
            line[v.offset:v.offset + v.size] += term["weights"] if term["weights"] is not None else term["weight"]
        constraints.append(LinearConstraint(id=c["id"], statement=c["statement"], kind=c["kind"], relation=c["relation"],
                                            bound=c["bound"], coefficients=line))
    return Problem(instance=name, split=instance["split"], values=Values.of(instance["values"]), variables=variables,
                   constraints=tuple(constraints), representation=candidate["representation"],
                   dimensions=candidate["dimensions"], objective=data.OBJECTIVE["name"],
                   direction=data.OBJECTIVE["direction"], units=data.OBJECTIVE["units"])


PROBLEMS: dict[str, Problem] = {name: _problem(name, instance) for name, instance in data.INSTANCES.items()}


def problem(name: str | None = None) -> Problem:
    """The instance named `name`, or the first one."""
    return PROBLEMS[name] if name is not None else next(iter(PROBLEMS.values()))
