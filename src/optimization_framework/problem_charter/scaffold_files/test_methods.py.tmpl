"""Every method in METHODS gives valid candidates, repeats with its seed and stops at its cap. Generated by Balsamic."""
from __future__ import annotations

import pytest

from __PKG__.harness import run
from __PKG__.methods import METHODS
from __PKG__.problem import problem

PROBLEM = problem()
# Time a run may take beyond max_seconds: the alarm stops a method between Python steps, not inside one.
GRACE_SECONDS = 1.0


@pytest.mark.parametrize("name", sorted(METHODS))
def test_a_method_evaluates_valid_candidates(name):
    result = run(METHODS[name], PROBLEM, seed=0, max_seconds=10, max_evaluations=50)   # an invalid one raises here
    assert result.best is not None, "The method evaluated nothing and returned nothing"
    assert PROBLEM.is_valid(result.best)


@pytest.mark.parametrize("name", sorted(METHODS))
def test_the_same_seed_gives_the_same_run(name):
    first, second = (run(METHODS[name], PROBLEM, seed=7, max_seconds=10, max_evaluations=30) for _ in range(2))
    values = [[row["value"] for row in result.log] for result in (first, second)]
    if "seconds" in (first.stopped, second.stopped):   # stopped by time: compare as far as both went
        length = min(map(len, values))
        values = [rows[:length] for rows in values]
    else:
        assert first.best == second.best
    assert values[0] == values[1]


@pytest.mark.parametrize("name", sorted(METHODS))
def test_a_method_stops_at_its_cap(name):
    counted = run(METHODS[name], PROBLEM, seed=0, max_seconds=10, max_evaluations=5)
    assert counted.evaluations <= 5
    timed = run(METHODS[name], PROBLEM, seed=0, max_seconds=0.5)
    assert timed.elapsed <= 0.5 + GRACE_SECONDS
